(* This axiom is workaround for:
 *   let isovalue: int = isovalues_arr[ranges_arr[irange]] in
 * in `find_clusters_centers`, so Why3 be able to prove bounds violation, it has all info
 * for it but it cannot connect separate items (to connect list/array items bound by
 * `LL.length isovalues`, ie, `ranges/ranges_arr` values are 0..|isovalues|-1).
 *)

axiom list_element_is_valid:
  forall l:L.list int, n k:int.
    list_elems_are_correct_index l n ->
    0 <= k < LL.length l ->
    match list_nth l k with
    | Some x -> 0 <= x < n
    | None -> false
    end


