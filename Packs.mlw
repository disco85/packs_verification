  let approximate_by_rectangles (ps: array int) (tolerance: int) : (L.list int, L.list int) =
  requires { tolerance > 0 }
  (* invariants and asserts help to prove `ensures`, else they fail with timeout *)
  ensures {
    length ps > 0 ->
      match result with
      | (a, b) -> LL.length a > 0 /\ LL.length b > 0
      end
  }
  ensures {
    match result with
    | (a, b) -> LL.length a <= LL.length b
    end  
  }
  ensures {
    (* connects 1st,2nd items of the returning tuple: `a` is a list of indexes in `b` *)
    match result with
    | (a, b) -> list_elems_are_correct_index a (LL.length b)
    end
  }
    let res_ps: ref (L.list int) = ref L.Nil in
    let res_ranges: ref (L.list int) = ref L.Nil in
    let slice: ref (L.list int) = ref L.Nil in
    for i = 0 to length ps - 1 do
    invariant { 0 <= i <= length ps }               (* Why3 checks the value after termination of loop to,
                                                       so `length ps` *)
    invariant { i > 0 -> LL.length !slice > 0 }
      (* call of `list_to_array` in loop is horrible performance, but for proving - it
       * is not not a problem. It is needed due to duality of Python's list (it is
       * translation from Python) - it is indexable but also appendable/extendable *)
      let p = ps[i] in
      if LL.length !slice = 0 then
        slice := !slice ++ (L.Cons p L.Nil)
      else if new_rect_is_needed (list_to_array !slice) p tolerance then
        begin
          let slice_avg = calc_avg (list_to_array !slice) in
          res_ps := !res_ps ++ (make_list (LL.length !slice) slice_avg);
          slice := make_list 1 p
        end
      else
        slice := !slice ++ (L.Cons p L.Nil)
    done;
    if LL.length !slice > 0 then
      begin
        let slice_avg = calc_avg (list_to_array !slice) in
        res_ps := !res_ps ++ (make_list (LL.length !slice) slice_avg)
      end;
    assert { LL.length !slice > 0 -> LL.length !res_ps > 0 };
    let pr: ref (option int) = ref None in
    let res_ps_arr: array int = list_to_array !res_ps in
    assert { length res_ps_arr = LL.length !res_ps };
    for i = 0 to length res_ps_arr - 1 do
    invariant { 0 <= i <= length res_ps_arr }
    invariant { i > 0 -> LL.length !res_ranges > 0 }
    invariant { LL.length !res_ranges <= i }          (* this is needed to avoid timeout on 2nd `ensures`
                                                         of the function *)
    invariant { list_elems_are_correct_index !res_ranges (length res_ps_arr) }
      if i = 0 then
        res_ranges := !res_ranges ++ (L.Cons i L.Nil)
      else if not option_eq !pr (Some res_ps_arr[i]) then
        res_ranges := !res_ranges ++ (L.Cons i L.Nil);
      pr := Some res_ps_arr[i]
    done;
    assert { length ps > 0 -> (LL.length !res_ranges > 0) /\ (LL.length !res_ps > 0) };
    (!res_ranges, !res_ps)
  

  let find_clusters_centers  (* TODO add ensures about size of result and maybe values in tuples *)
    (ranges isovalues: L.list int) (ratio: int) (nesting: int): L.list (int, int) =
  requires { LL.length ranges <= LL.length isovalues }
  requires { list_elems_are_correct_index ranges (LL.length isovalues) }
  if LL.length ranges = 0 || LL.length isovalues = 0 then
    L.Nil
  else begin
    let res: ref (L.list (int, int)) = ref L.Nil in
    let max_irange: int = LL.length ranges - 1 in
    let prev_isovalue: ref (option int) = ref None in
    let ranges_arr: array int = list_to_array ranges in
    let isovalues_arr: array int = list_to_array isovalues in
    assert { (* TODO asserts can be removed *)
      forall k:int. 0 <= k < LL.length isovalues ->
      Some isovalues_arr[k] = list_nth isovalues k };
    assert {
      forall k:int. 0 <= k < LL.length ranges ->
      Some ranges_arr[k] = list_nth ranges k };
    for irange = 0 to max_irange do
      (* Why3 checks automatically "indexes out of bounds" when it sees `[..]`. Here too.
       * `irange` is OK obviously, but `isovalues_arr[..]` is not obvious: the 2nd `requires {..}`
       * is not enough bcs Why3 does not know that `isovalues` are the same items as `isovalues_arr`
       * (XXX current implementation of `list_to_array` does not ensure it - this must be fixed!!!)
       *)
      let isovalue: int = isovalues_arr[ranges_arr[irange]] in
      let skip_common: ref bool = ref false in
      let left: ref int = ref 0 in
      let right: ref int = ref 0 in    
      match !prev_isovalue with
      | None                 -> ()
      | Some prev_isovalue_v ->
        if isovalue > prev_isovalue_v && num_ge (calc_ratio isovalue prev_isovalue_v) (Fin ratio) then
        begin
          right := ranges_arr[irange];
          left := ranges_arr[max (irange - 1) 0]
        end
        else if isovalue < prev_isovalue_v && num_ge (calc_ratio prev_isovalue_v isovalue) (Fin ratio) then
        begin
          left := ranges_arr[irange];
          right := ranges_arr[min (irange + 1) max_irange]
        end
        else
        begin
          prev_isovalue := Some isovalue;
          skip_common := true
        end;
        if not !skip_common then
        begin
          if !right = !left then incr right;
          left := !left + nesting;
          right := !right + nesting;
          if LL.length !res = 0 || not (option_tuple_eq (list_last !res) (Some (!left, !right))) then
            res := !res ++ (L.Cons (!left, !right) L.Nil);
        end
      end;
      prev_isovalue := Some isovalue
    done;
    !res
  end


