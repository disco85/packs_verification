(*

NOTE: use Z3 (default CVC4 leads to timeout, at least on new_rect_is_needed):
- install Z3
- why3 config detect
- why3 config list-provers : and you should see Z3. Then use z3 in "-P z3" option
*)

module Packs
  use int.Int
  use int.Abs
  use int.MinMax
  use ref.Refint
  use array.Array
  use list.List as L
  use list.Append
  use list.Length as LL
  use list.Nth as LN
  use list.Mem as LM
  use option.Option
  use int.ComputerDivision as CD
  (*use int.EuclideanDivision as CD*)

  type num =
    | NaN
    | MinusInf
    | Fin int
    | PlusInf


  let sign (a:int) : int =
  ensures { result = -1 \/ result = 1 }
    if a < 0 then -1 else 1

  (*axiom Div_a1 :
    forall a b:int. b <> 0 -> (CD.div a b) <= a
  lemma div_mult_le :
    forall a b:int. b <> 0 -> (CD.div a b) * b <= a *)


  let round_div (x y: int) : int =
  requires { y <> 0 }
  ensures { x = 0 -> result = 0 }
  ensures { x > 0 /\ y > 0 -> (x - y) <= (result * y) <= (x + y) }  (* TODO do it better! *)
  ensures { x < 0 /\ y > 0 -> (x - y) <= (result * y) <= (x + y) }
    if x >= 0 then CD.div (x + (CD.div y 2)) y
    else           CD.div (x - (CD.div y 2)) y
    

  (* `function` - logic/specification, can be used in predicates. `let ...` - program/execution, cannot be *)
  
  let num_ge (x y: num) : bool =
    match x, y with
    | NaN, _             -> false
    | _, NaN             -> false
    | MinusInf, MinusInf -> false
    | MinusInf, _        -> false
    | PlusInf, PlusInf   -> false
    | PlusInf, _         -> true
    | _, PlusInf         -> false
    | _, MinusInf        -> true
    | Fin a, Fin b       -> a >= b
    end

  let num_gt (x y: num) : bool =
    match x, y with
    | NaN, _             -> false
    | _, NaN             -> false
    | MinusInf, MinusInf -> false
    | MinusInf, _        -> false
    | PlusInf, PlusInf   -> false
    | PlusInf, _         -> true
    | _, PlusInf         -> false
    | _, MinusInf        -> true
    | Fin a, Fin b       -> a > b
    end


  let calc_avg (ps: array int) : int =
    if length ps = 0 then 0
    else begin
      let sum: ref int = ref 0 in
      for i = 0 to length ps - 1 do
        sum := !sum + ps[i]
      done;
      round_div !sum (length ps)
    end


  let arr_minmax (ps: array int) (cmp: int -> int -> bool) : option int =
  ensures { length ps > 0 <-> result <> None }  
  ensures { length ps = 0 <-> result = None }
    if length ps = 0 then None
    else begin
      let m: ref (option int) = ref None in
      for i = 0 to length ps - 1 do
      invariant { 0 < i -> !m <> None }   (* variant {..} is irrelevant for `for`-s *)
        match !m with
          | None        -> m := Some ps[i]
          | Some prev_m -> if (cmp prev_m ps[i]) then m := Some ps[i]
        end
      done;
      !m
    end


  let arr_min (ps: array int) : option int =
  ensures { length ps > 0 <-> result <> None }  
  ensures { length ps = 0 <-> result = None }
    arr_minmax ps (<)


  let arr_max (ps: array int) : option int =
  ensures { length ps > 0 <-> result <> None }    
  ensures { length ps = 0 <-> result = None }
    arr_minmax ps (>)


  let array_max (ps: array int) : int =
  requires { length ps > 0 }
    let m: ref int = ref ps[0] in
    for i = 0 to length ps - 1 do
      if !m > ps[i] then m := ps[i]
    done;
    !m


  let array_min (ps: array int) : int =
  requires { length ps > 0 }
    let m: ref int = ref ps[0] in
    for i = 0 to length ps - 1 do
      if !m < ps[i] then m := ps[i]
    done;
    !m


  let calc_diffs (ps: array int) (absolute: bool) : array int =
  ensures {
    (length ps = 0 -> length result = 0) /\
    (length ps > 0 -> length result = length ps - 1)
  }
    let diffs_num = max ((length ps) - 1) 0 in
    let diffs = make diffs_num 0 in
    let i:ref int = ref 0 in
    if diffs_num = 0 then
      diffs
    else begin
      while !i <> length ps - 1 do
      invariant { 0 <= !i <= length ps - 1 }
      invariant { !i <= length diffs }
      variant { length ps - 1 - !i }
        let diff = ps[!i + 1] - ps[!i] in
        let diff = if absolute then abs diff else diff in
        diffs[!i] <- diff;
        incr i
      done;
      diffs
    end


  let calc_ratio (x y:int) : num =
    let abs_x = abs x in
    let abs_y = abs y in
    let res_sign = (sign x) * (sign y) in
    if (abs_x = 0) && (abs_y = 0) then
      NaN
    else if abs_x > abs_y then
      if abs_y = 0 then
        if res_sign < 0 then MinusInf
        else PlusInf
      else
        Fin (round_div x y)
    else if abs_x < abs_y then
      if abs_x = 0 then
        if res_sign < 0 then MinusInf
        else PlusInf
      else
        Fin (round_div y x)
    else
      if abs_x = 0 then NaN
      else (Fin res_sign)


  let rec list_min (l: L.list int) : int =
  requires { l <> L.Nil }
  variant  { LL.length l }
    match l with
    | L.Nil -> absurd
    | L.Cons x L.Nil -> x
    | L.Cons x r ->
        let m = list_min r in
        if x < m then x else m
    end


  let rec list_max (l: L.list int) : int =
  requires { l <> L.Nil }
  variant  { LL.length l }
    match l with
    | L.Nil -> absurd
    | L.Cons x L.Nil -> x
    | L.Cons x r ->
        let m = list_max r in
        if x > m then x else m
    end


  let new_rect_is_needed (slice: array int) (p: int) (tolerance: int) : bool =
  requires { length slice > 0 }
  requires { tolerance > 0 }
    let slice_max: int = array_max slice in
    let slice_min: int = array_min slice in
      (num_gt (calc_ratio p slice_max) (Fin tolerance)) ||
      (num_gt (calc_ratio p slice_min) (Fin tolerance))


  let new_rect_is_needed_1 (slice: array int) (p: int) (tolerance: int) : option bool =
  requires { tolerance >= 0 }
  ensures { length slice > 0 -> result <> None }
    if length slice > 0 then
      let slice_max: option int = arr_max slice in
      let slice_min: option int = arr_min slice in
      match (slice_max, slice_min) with
      | (Some slice_max1, Some slice_min1) ->
        let r = (num_gt (calc_ratio p slice_max1) (Fin tolerance)) ||
                (num_gt (calc_ratio p slice_min1) (Fin tolerance))
        in Some r      
      | _, _                               -> absurd  (* `absurd` instructs Why3 to check validity of it
                                                         ie, that it is really unreachable, ie, it is
                                                         absurd! If yes, it will be reported as "Valid" *)
      end
    else None


  let new_rect_is_needed_2 (slice: L.list int) (p: int) (tolerance: int) : bool =
  requires { LL.length slice > 0 }
  requires { tolerance > 0 }
    let slice_max: int = list_max slice in
    let slice_min: int = list_min slice in
      (num_gt (calc_ratio p slice_max) (Fin tolerance)) ||
      (num_gt (calc_ratio p slice_min) (Fin tolerance))


  let rec function list_nth (l: L.list int) (n: int): option int =
  requires { 0 <= n < LL.length l }
  ensures {
    match result with
    | Some el -> LM.mem el l
    | None    -> false
    end
  }
  variant { n }
  match l with
  | L.Cons x tl -> if n = 0 then Some x else list_nth tl (n - 1)
  | L.Nil -> None
  end


  let list_to_array (l: L.list int) : array int =
    ensures { LL.length l = length result }
    ensures {
      (* preserving of elements *)
      forall k:int. 0 <= k < LL.length l ->
        Some result[k] = list_nth l k
    }
    let a = make (LL.length l) 0 in
    for i = 0 to LL.length l - 1 do
      (* These 2 invariants are needed to overcome the fact that Why3 reasons about
       * the current state and invariants - it does not "know" the history of what
       * it executed at prev. steps. These invariants help to prove `ensures` about
       * preserving of elements. The 2nd invariant exactly checks the history and
       * connects `l` + every item in it saved early is in the same position of `a`!
       *)
      invariant { 0 <= i <= LL.length l }
      invariant {
        forall k:int. 0 <= k < i ->
          Some a[k] = list_nth l k      (* check of history *)
      }
      match list_nth l i with
      | Some el -> a[i] <- el;
      | None    -> absurd
      end;
    done;
    a


  let rec make_list (n: int) (el: int) : L.list int =
  requires { n >= 0 }
  ensures { LL.length result = n }
  ensures { forall i: int. 0 <= i < LL.length result ->
            LN.nth i result = Some el }  
  variant { n }
    if n = 0 then
      L.Nil
    else
      L.Cons el (make_list (n - 1) el)


  let option_eq (x: option int) (y: option int) : bool =
    match x, y with
    | Some xx, Some yy -> xx = yy
    | None, None       -> true
    | _, _             -> false
    end


  let option_tuple_eq (x: option (int, int)) (y: option (int, int)) : bool =
    match x, y with
    | Some (x1, x2), Some (y1, y2) -> x1 = y1 && x2 = y2
    | None, None       -> true
    | _, _             -> false
    end


  let rec list_last (l: L.list 'a) : option 'a =
  variant { l }
    match l with
    | L.Nil          -> None
    | L.Cons x L.Nil -> Some x
    | L.Cons _ r     -> list_last r
    end


  predicate list_elems_are_correct_index (l: L.list int) (n: int) =
  (* The predicate checks that all elements in the list `l` can be index bounded by `n`,
   * ie, 0 <= el < n. IT is used in `list_elems_are_correct_index__append_singleton` lemma
   *)
    match l with
    | L.Nil      -> true
    | L.Cons x r -> 0 <= x < n /\ list_elems_are_correct_index r n
    end


  (* This lemma is needed to prove the invariant:
   *
   *   invariant { list_elems_are_correct_index !res_ranges (length res_ps_arr) }
   *
   * in `approximate_by_rectangles`. This invariant tells that every item is `res_ranges`
   * is a index of items in `res_ps`/`res_ps_arr` (`res_ranges` is a list of indexes, so
   * no one item in `res_ranges` can violate the `res_ps` bounds - it can be useful in
   * the next function: `find_clusters_centers`). But to prove this invarint, we have
   * to hint Why3 with some lemma. Without it, we hit timeout/out of memory.
   *
   * It seems the timeout problem is connected with construction of a list and need to
   * check the invariant when the list is growing (?) - we add `i` to the list, and we
   * know that `i` is inside bounds, so Why3 has to check that adding only of `i` to a
   * list means that all items of that list are inside the same bounds. More detailed:
   * Z3/CVC4/... do not automatically know that `list_elems_lt` is preserved by `++` !
   *
   * This lemma proves it by induction. `requires` is A, `ensures` is B in A -> B.
   * `variant` is a termination measure (bcs the lemma is recursive).
   * The logic of the lemma is in its body (it is like FStar) - returning of () means
   * "true/fact!", and we prove the base of the induction for an empty list then
   * we state that for non-empty list we pass through it to the base case ("next step"?),
   * the proposition that we prove is B, ie:
   *
   *   ∀x: 0 <= x < n                             (any integer that is also valid index)
   *   list_elems_are_correct_index (l ++ [x]) n  (property is preserved after .. ++ [x])
   * 
   *)
  let rec lemma list_elems_are_correct_index__append_singleton (l: L.list int) (x n: int) =
  requires { list_elems_are_correct_index l n /\ 0 <= x < n }
  variant { LL.length l }
  ensures { list_elems_are_correct_index (l ++ L.Cons x L.Nil) n }
    match l with
    | L.Nil      -> ()
    | L.Cons _ r -> list_elems_are_correct_index__append_singleton r x n
    end


